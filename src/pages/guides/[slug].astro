---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import Photo from "../../components/Photo.astro";
import Credit from "../../components/Credit.astro";
import { brand } from "../../brand";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide, guides } }));
}
const { guide, guides } = Astro.props;
const { Content } = await render(guide);
const crumbs = [{ label: "Guides", href: "/guides/" }, { label: guide.data.title }];
const others = guides.filter((g) => g.id !== guide.id).sort((a, b) => a.data.order - b.data.order);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const schema = [{
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  dateModified: guide.data.updated.toISOString(),
  author: { "@id": `${brand.url}/#org` },
  publisher: { "@id": `${brand.url}/#org` },
  mainEntityOfPage: `${brand.url}/guides/${guide.id}/`,
}];
---

<Base title={guide.data.title} description={guide.data.description} image={guide.data.image} type="article" crumbs={crumbs} schema={schema} markdown={`/guides/${guide.id}.md`}>
  <article>
    <div class="wrap page-head">
      <Crumbs items={crumbs} />
      <h1>{guide.data.title}</h1>
      <p class="lead">{guide.data.summary}</p>
      <p class="meta" style="margin-top:.8rem">Updated <time datetime={guide.data.updated.toISOString()}>{fmt(guide.data.updated)}</time></p>
    </div>
    <div class="wrap">
      <figure class="figure">
        <Photo slot={guide.data.image} alt={guide.data.imageAlt} kind="wide" eager />
        <figcaption><Credit slot={guide.data.image} /></figcaption>
      </figure>
      <div class="layout" style="margin-top:1.5rem">
        <div class="prose"><Content /></div>
        <aside class="aside">
          <h2>More guides</h2>
          <ul>{others.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}</ul>
        </aside>
      </div>
    </div>
  </article>
</Base>
